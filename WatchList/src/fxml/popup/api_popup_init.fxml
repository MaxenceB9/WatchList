<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="200.0" maxWidth="300.0" minHeight="200.0" minWidth="300.0" prefHeight="200.0" prefWidth="300.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.popup.APIpopupControl">
   <children>
      <VBox alignment="CENTER" fillWidth="false" maxHeight="200.0" maxWidth="300.0" minHeight="200.0" minWidth="300.0" prefHeight="200.0" prefWidth="300.0">
         <children>
            <Label prefHeight="35.0" prefWidth="195.0" text="SET YOUR API KEY" textOverrun="CLIP">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <TextField fx:id="input" prefHeight="25.0" prefWidth="220.0" />
            <Button fx:id="save" mnemonicParsing="false" onAction="#SaveClick" text="Save" />
            <Hyperlink text="Tackt TV" />
         </children>
      </VBox>
      <TextField layoutX="-2.0" layoutY="-116.0" prefHeight="25.0" prefWidth="220.0" />
   </children>
</AnchorPane>
